# 复制成 .env 后按需修改（.env 已在 .gitignore 中，不会上传仓库）
# 真实环境变量优先于本文件，便于临时覆盖某一项。

# ---- 服务本体 ----
NOTIFY_BRAND=notify-service       # 邮件外壳页眉、发件人显示名的兜底值
NOTIFY_ADDR=127.0.0.1:8090
NOTIFY_TOKEN=                     # 设置后 /api/* 需要 Authorization: Bearer <token>；配置 TEAMUSERS_URL 时本项被忽略
NOTIFY_LOG_LEVEL=info

# ---- 存储（PostgreSQL，必填）----
# 必填；留空时服务拒绝启动。表对象统一建在固定 schema nsc_msghub（启动时幂等创建），不占用 public：
# 库用户需要该库的 CREATE 权限，或由 DBA 预先执行
#   CREATE SCHEMA nsc_msghub AUTHORIZATION <运行用户>;
NOTIFY_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/msghub?sslmode=disable
NOTIFY_RECORD_LIMIT=0             # 投递记录保留条数：0 = 全部保留；>0 = 每次写入后只保留最新 N 条

# ---- teamusers 鉴权（配置后接管 /api/*，静态 NOTIFY_TOKEN 退场）----
# 打开后 /api/* 只认 teamusers 签发的 JWT：缺/坏 token 401，权限不足 403；
# /healthz 与测试页面保持公开。未知 /api/ 路径只要求认证，随后照旧 404。
# NOTIFY_TEAMUSERS_URL=http://127.0.0.1:8080
# NOTIFY_TEAMUSERS_AUDIENCE=teamusers         # 期望的 JWT aud
# 服务凭证二选一（同时配置时以 client-credentials 为准）：
# NOTIFY_TEAMUSERS_CLIENT_ID=msghub           # 服务账号 client_id（teamusers 用户名）
# NOTIFY_TEAMUSERS_CLIENT_SECRET=             # 服务账号一次性密钥；启动即换取服务令牌，到期前自动刷新
# NOTIFY_TEAMUSERS_SERVICE_TOKEN=             # 静态服务令牌（kind=service 的 access token），仅在不用 client-credentials 时配置
# NOTIFY_TEAMUSERS_TIMEOUT=5                  # JWKS/权限接口超时（秒）
# NOTIFY_TEAMUSERS_PERMISSION_SEND=msghub:send:any   # POST /api/v1/notify、邮件自检
# NOTIFY_TEAMUSERS_PERMISSION_READ=msghub:read:any   # 通道状态与投递记录查询

# ---- 发件邮箱（不配则邮件通道不可用，除非显式开 dev outbox）----
NOTIFY_SMTP_HOST=smtp.qq.com
NOTIFY_SMTP_PORT=465              # QQ/163 用 465 + implicit；587 用 starttls
NOTIFY_SMTP_TLS=implicit          # auto | starttls | implicit | none
NOTIFY_SMTP_USER=you@qq.com
NOTIFY_SMTP_PASS=                 # 邮箱里生成的 SMTP 授权码，不是登录密码
NOTIFY_SMTP_FROM=you@qq.com       # 留空则等于 NOTIFY_SMTP_USER（QQ 要求二者一致）
NOTIFY_SMTP_FROM_NAME=            # 留空则等于 NOTIFY_BRAND
NOTIFY_MAIL_FOOTER=               # 邮件页脚提示语，留空自动生成
NOTIFY_SMTP_TIMEOUT=15

# ---- 用户目录（二选一；都配则优先用户服务）----
# 本地用户表存放在 PostgreSQL 的 users 表（id、name、channels），可直接用 SQL 维护，
# 例如（channels 为 JSONB，键为渠道名）：
#   INSERT INTO nsc_msghub.users (id, name, channels) VALUES ('u1', '张三', '{"email":"a@qq.com"}')
#     ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, channels = EXCLUDED.channels;
# NOTIFY_USER_SERVICE_URL=http://127.0.0.1:8080
# NOTIFY_USER_SERVICE_PATH=/api/users/{id}
# NOTIFY_USER_SERVICE_TOKEN=
# NOTIFY_USER_SERVICE_TIMEOUT=5

# ---- 通知类型 → 渠道路由（服务自己决定往哪发）----
# 例：alert 同时发邮件和短信，digest 只发邮件，未命中的类型走 default
NOTIFY_ROUTES=alert=email,sms;digest=email;default=email

# ---- 模拟开关：默认关闭，避免"以为发了其实没发" ----
NOTIFY_SMS_SIMULATE=0             # 1 = 用本地模拟短信上游（只写 outbox_messages 表）
NOTIFY_DEV_OUTBOX=0               # 1 = 未配置 SMTP 时把邮件写进 outbox_messages 表
